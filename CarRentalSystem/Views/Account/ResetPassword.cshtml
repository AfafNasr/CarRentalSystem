@model CarRentalSystem.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - DriveEase</title>

    <link rel="stylesheet"
          href="~/css/password-reset.css"
          asp-append-version="true" />
</head>

<body>

    <div class="auth-page">

        <div class="auth-card">

            <div class="auth-brand">

                <h2>
                    Drive<span>Ease</span>
                </h2>

                <p>Premium Car Rental</p>

            </div>

            <div class="auth-title">

                <h1>Create New Password</h1>

                <p>
                    Choose a strong new password for your account.
                </p>

            </div>

            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post">

                <input asp-for="Token"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">

                    <label asp-for="NewPassword"></label>

                    <input asp-for="NewPassword"
                           class="form-control-custom"
                           placeholder="Enter new password" />

                    <span asp-validation-for="NewPassword"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="ConfirmPassword"></label>

                    <input asp-for="ConfirmPassword"
                           class="form-control-custom"
                           placeholder="Confirm new password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="validation-message">
                    </span>

                </div>

                <button type="submit"
                        class="auth-button">
                    Reset Password
                </button>

            </form>

            <a asp-controller="Account"
               asp-action="Login"
               class="auth-link">
                ← Back to Sign In
            </a>

        </div>

    </div>

</body>
</html>