@model CarRentalSystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Change Password - DriveEase</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/change-password.css"
          asp-append-version="true" />

</head>


<body>


    <header class="main-header">

        <a asp-controller="Cars"
           asp-action="Index"
           class="brand">

            <span class="brand-icon">
                🚘
            </span>

            <div>

                <h2>
                    Drive<span>Ease</span>
                </h2>

                <small>
                    PREMIUM CAR RENTAL
                </small>

            </div>

        </a>


        <nav class="navigation">

            <a asp-controller="Cars"
               asp-action="Index">
                Cars
            </a>

            <a asp-controller="Reservations"
               asp-action="MyReservations">
                My Reservations
            </a>

            <a asp-controller="Account"
               asp-action="Profile"
               class="active">
                Profile
            </a>

        </nav>


        <div class="user-menu">

            <div class="user-info">

                <span>
                    Welcome
                </span>

                <strong>
                    @User.Identity?.Name
                </strong>

            </div>


            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="logout-button">

                    Logout

                </button>

            </form>

        </div>

    </header>



    <main class="password-page">


        <div class="page-heading">

            <span>
                ACCOUNT SECURITY
            </span>

            <h1>
                Change Password
            </h1>

            <p>
                Update your password to keep your account secure.
            </p>

        </div>



        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="success-message">

                <span>
                    ✓
                </span>

                @TempData["PasswordSuccess"]

            </div>
        }



        <div class="password-layout">


            <!-- LEFT PANEL -->

            <aside class="security-panel">

                <div class="security-icon">
                    🔐
                </div>

                <h2>
                    Account Security
                </h2>

                <p>
                    Use a strong password that you don't use
                    on other websites.
                </p>


                <div class="security-divider">
                </div>


                <div class="security-tip">

                    <span>
                        ✓
                    </span>

                    <div>
                        <strong>
                            Use at least 8 characters
                        </strong>

                        <p>
                            Longer passwords are generally more secure.
                        </p>
                    </div>

                </div>


                <div class="security-tip">

                    <span>
                        ✓
                    </span>

                    <div>
                        <strong>
                            Mix character types
                        </strong>

                        <p>
                            Include uppercase, lowercase, numbers
                            and special characters.
                        </p>
                    </div>

                </div>


                <div class="security-tip">

                    <span>
                        ✓
                    </span>

                    <div>
                        <strong>
                            Keep it private
                        </strong>

                        <p>
                            Never share your password with anyone.
                        </p>
                    </div>

                </div>

            </aside>



            <!-- FORM CARD -->

            <section class="password-card">


                <div class="card-heading">

                    <span>
                        SECURITY SETTINGS
                    </span>

                    <h2>
                        Update Your Password
                    </h2>

                    <p>
                        Enter your current password before choosing a new one.
                    </p>

                </div>



                <form asp-controller="Account"
                      asp-action="ChangePassword"
                      method="post">


                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>



                    <!-- CURRENT PASSWORD -->

                    <div class="form-field">

                        <label asp-for="CurrentPassword">
                        </label>


                        <div class="password-wrapper">

                            <input asp-for="CurrentPassword"
                                   id="currentPassword"
                                   placeholder="Enter your current password" />

                            <button type="button"
                                    class="toggle-password"
                                    data-target="currentPassword">

                                Show

                            </button>

                        </div>


                        <span asp-validation-for="CurrentPassword"
                              class="validation-message">
                        </span>

                    </div>



                    <!-- NEW PASSWORD -->

                    <div class="form-field">

                        <label asp-for="NewPassword">
                        </label>


                        <div class="password-wrapper">

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   placeholder="Create a new password" />

                            <button type="button"
                                    class="toggle-password"
                                    data-target="newPassword">

                                Show

                            </button>

                        </div>


                        <div class="password-strength">

                            <div class="strength-track">

                                <div id="passwordStrengthBar"
                                     class="strength-bar">
                                </div>

                            </div>


                            <span id="passwordStrengthText"
                                  class="strength-text">

                                Password strength

                            </span>

                        </div>



                        <div class="password-rules">

                            <span id="ruleLength">
                                ✓ 8+ characters
                            </span>

                            <span id="ruleUpper">
                                ✓ Uppercase
                            </span>

                            <span id="ruleLower">
                                ✓ Lowercase
                            </span>

                            <span id="ruleNumber">
                                ✓ Number
                            </span>

                            <span id="ruleSpecial">
                                ✓ Special character
                            </span>

                        </div>


                        <span asp-validation-for="NewPassword"
                              class="validation-message">
                        </span>

                    </div>



                    <!-- CONFIRM PASSWORD -->

                    <div class="form-field">

                        <label asp-for="ConfirmNewPassword">
                        </label>


                        <div class="password-wrapper">

                            <input asp-for="ConfirmNewPassword"
                                   id="confirmPassword"
                                   placeholder="Confirm your new password" />

                            <button type="button"
                                    class="toggle-password"
                                    data-target="confirmPassword">

                                Show

                            </button>

                        </div>


                        <span asp-validation-for="ConfirmNewPassword"
                              class="validation-message">
                        </span>

                    </div>



                    <div class="form-actions">


                        <a asp-controller="Account"
                           asp-action="Profile"
                           class="cancel-button">

                            Back to Profile

                        </a>


                        <button type="submit"
                                class="save-button">

                            Change Password

                            <span>
                                →
                            </span>

                        </button>


                    </div>


                </form>


            </section>


        </div>


    </main>



    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js">
    </script>

    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js">
    </script>


    <script>

            // Show / Hide Password

            document.querySelectorAll(".toggle-password")
                .forEach(button => {

                    button.addEventListener("click", function() {

                        const targetId =
                            this.dataset.target;

                        const input =
                            document.getElementById(targetId);

                        const isHidden =
                            input.type === "password";

                        input.type =
                            isHidden
                                ? "text"
                                : "password";

                        this.textContent =
                            isHidden
                                ? "Hide"
                                : "Show";
                    });

                });



            // Password Strength

            const newPassword =
                document.getElementById("newPassword");

            const strengthBar =
                document.getElementById("passwordStrengthBar");

            const strengthText =
                document.getElementById("passwordStrengthText");


            const ruleLength =
                document.getElementById("ruleLength");

            const ruleUpper =
                document.getElementById("ruleUpper");

            const ruleLower =
                document.getElementById("ruleLower");

            const ruleNumber =
                document.getElementById("ruleNumber");

            const ruleSpecial =
                document.getElementById("ruleSpecial");


            newPassword.addEventListener("input", function() {

                const password =
                    newPassword.value;


                const rules = {

                    length:
                        password.length >= 8,

                    upper:
                        /[A-Z]/.test(password),

                    lower:
                        /[a-z]/.test(password),

                    number:
                        /[0-9]/.test(password),

                    special:
                        /[^A-Za-z0-9]/.test(password)

                };


                updateRule(
                    ruleLength,
                    rules.length
                );

                updateRule(
                    ruleUpper,
                    rules.upper
                );

                updateRule(
                    ruleLower,
                    rules.lower
                );

                updateRule(
                    ruleNumber,
                    rules.number
                );

                updateRule(
                    ruleSpecial,
                    rules.special
                );


                const score =
                    Object.values(rules)
                        .filter(Boolean)
                        .length;


                strengthBar.style.width =
                    (score * 20) + "%";


                if (password.length === 0) {

                    strengthText.textContent =
                        "Password strength";

                    strengthBar.className =
                        "strength-bar";

                }

                else if (score <= 2) {

                    strengthText.textContent =
                        "Weak password";

                    strengthBar.className =
                        "strength-bar weak";

                }

                else if (score <= 4) {

                    strengthText.textContent =
                        "Medium password";

                    strengthBar.className =
                        "strength-bar medium";

                }

                else {

                    strengthText.textContent =
                        "Strong password";

                    strengthBar.className =
                        "strength-bar strong";

                }

            });



            function updateRule(element, valid) {

                if (valid) {

                    element.classList.add("valid");

                }

                else {

                    element.classList.remove("valid");

                }

            }

    </script>


</body>

</html>