@model CarRentalSystem.ViewModels.CarSearchViewModel

@{
    ViewData["Title"] = "Available Cars";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Available Cars - DriveEase</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/cars.css"
          asp-append-version="true" />
</head>

<body>

    <header class="main-header">

        <a asp-controller="Cars"
           asp-action="Index"
           class="brand">

            <span class="brand-icon">🚘</span>

            <div>
                <h2>Drive<span>Ease</span></h2>
                <small>PREMIUM CAR RENTAL</small>
            </div>

        </a>


        <nav class="navigation">

            <a asp-controller="Cars"
               asp-action="Index"
               class="active">
                Cars
            </a>

            <a href="#">
                My Reservations
            </a>

            <a href="#">
                Profile
            </a>

        </nav>


        <div class="user-menu">

            <div class="user-info">
                <span class="welcome-text">
                    Welcome
                </span>

                <strong>
                    @User.Identity?.Name
                </strong>
            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit"
                        class="logout-button">
                    Logout
                </button>

            </form>

        </div>

    </header>


    <main>

        <!-- HERO -->

        <section class="hero">

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <span class="hero-label">
                    FIND YOUR PERFECT RIDE
                </span>

                <h1>
                    Wherever You Go,<br />
                    <span>We’ll Get You There.</span>
                </h1>

                <p>
                    Explore our premium fleet and find the perfect
                    vehicle for your next journey.
                </p>

            </div>

        </section>


        <!-- SEARCH -->

        <section class="search-wrapper">

            <div class="search-card">

                <div class="search-title">
                    <h3>Find Your Car</h3>

                    <p>
                        Choose your location and preferences
                    </p>
                </div>


                <form method="get"
                      asp-controller="Cars"
                      asp-action="Index"
                      class="search-form">

                    <div class="search-field">
                        <label asp-for="Location"></label>

                        <select asp-for="Location">
                            <option value="">All Locations</option>
                            <option value="Nablus">Nablus</option>
                            <option value="Ramallah">Ramallah</option>
                            <option value="Jenin">Jenin</option>
                            <option value="Bethlehem">Bethlehem</option>
                        </select>
                    </div>


                    <div class="search-field">
                        <label asp-for="PickupDate"></label>

                        <input asp-for="PickupDate"
                               type="date" />

                        <span asp-validation-for="PickupDate"
                              class="search-validation"></span>
                    </div>


                    <div class="search-field">
                        <label asp-for="ReturnDate"></label>

                        <input asp-for="ReturnDate"
                               type="date" />

                        <span asp-validation-for="ReturnDate"
                              class="search-validation"></span>
                    </div>


                    <div class="search-field">
                        <label asp-for="Type"></label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<CarRentalSystem.Models.CarType>()">

                            <option value="">All Types</option>

                        </select>
                    </div>


                    <div class="search-field">
                        <label asp-for="Transmission"></label>

                        <select asp-for="Transmission"
                                asp-items="Html.GetEnumSelectList<CarRentalSystem.Models.TransmissionType>()">

                            <option value="">Any</option>

                        </select>
                    </div>


                    <button type="submit"
                            class="search-button">

                        Search Cars
                        <span>→</span>

                    </button>

                </form>

            </div>

        </section>


        <!-- CARS -->

        <section class="cars-section">

            <div class="section-header">

                <div>
                    <span class="section-label">
                        OUR FLEET
                    </span>

                    <h2>
                        Available Cars
                    </h2>

                    <p>
                        Choose from our collection of vehicles.
                    </p>
                </div>


                <div class="cars-count">

                    @Model.Cars.Count

                    <span>
                        cars available
                    </span>

                </div>

            </div>


            @if (!Model.Cars.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        🚗
                    </div>

                    <h3>
                        No cars available
                    </h3>

                    <p>
                        Try changing your search preferences.
                    </p>

                </div>
            }
            else
            {
                <div class="cars-grid">

                    @foreach (var car in Model.Cars)
                    {
                        <article class="car-card">

                            <div class="car-image-wrapper">

                                <img src="@car.ImageUrl"
                                     alt="@car.Brand @car.Model"
                                     class="car-image" />

                                <span class="car-type">
                                    @car.Type
                                </span>

                            </div>


                            <div class="car-content">

                                <div class="car-heading">

                                    <div>

                                        <span class="car-brand">
                                            @car.Brand
                                        </span>

                                        <h3>
                                            @car.Model
                                        </h3>

                                    </div>

                                    <span class="car-year">
                                        @car.Year
                                    </span>

                                </div>


                                <div class="car-location">

                                    <span>📍</span>

                                    @car.Location

                                </div>


                                <div class="car-features">

                                    <div class="feature">

                                        <span class="feature-icon">
                                            ⚙
                                        </span>

                                        <span>
                                            @car.Transmission
                                        </span>

                                    </div>


                                    <div class="feature">

                                        <span class="feature-icon">
                                            ⛽
                                        </span>

                                        <span>
                                            @car.FuelType
                                        </span>

                                    </div>


                                    <div class="feature">

                                        <span class="feature-icon">
                                            👥
                                        </span>

                                        <span>
                                            @car.Seats Seats
                                        </span>

                                    </div>

                                </div>


                                <div class="car-footer">

                                    <div class="price">

                                        <span class="currency">
                                            $
                                        </span>

                                        <strong>
                                            @car.DailyRate.ToString("0")
                                        </strong>

                                        <span class="per-day">
                                            / day
                                        </span>

                                    </div>


                                    <a asp-controller="Cars"
                                       asp-action="Details"
                                       asp-route-id="@car.Id"
                                       class="details-button">

                                        View Details

                                        <span>→</span>

                                    </a>

                                </div>

                            </div>

                        </article>
                    }

                </div>
            }

        </section>

    </main>


    <footer class="main-footer">

        <div class="footer-brand">

            <strong>
                Drive<span>Ease</span>
            </strong>

            <p>
                Premium cars. Simple booking.
            </p>

        </div>

        <span>
            © 2026 DriveEase
        </span>

    </footer>

</body>
</html>